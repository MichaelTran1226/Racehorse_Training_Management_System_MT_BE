# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL / Supabase / Local PostgreSQL)
# For Supabase:
# DATABASE_URL: Transaction pooler URL (e.g., port 6543)
# DIRECT_URL: Direct session connection URL for Prisma migrations (e.g., port 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/racehorse_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/racehorse_db?schema=public"

# Authentication & JWT Configuration
JWT_SECRET="equiflow-secure-jwt-secret-replace-in-production-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="equiflow-secure-refresh-jwt-secret-replace-in-production-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# Email / Notification Mock or SMTP (For Staff Invite & Owner OTP verification)
EMAIL_PROVIDER="mock"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="EquiFlow System <noreply@equiflow.com>"
# true = mọi mã OTP luôn là 123456 (tiện test). Đặt false khi demo thật.
DEV_FIXED_OTP=true

# GitHub Project Management (Governance)
GITHUB_PROJECT_URL=https://github.com/users/MichaelTran1226/projects/2
GITHUB_OWNER=MichaelTran1226
GITHUB_DEFAULT_REPOSITORY=Racehorse_Training_Management_System_MT_BE
GITHUB_BE_REPOSITORY=Racehorse_Training_Management_System_MT_BE
GITHUB_FE_REPOSITORY=Racehorse_Training_Management_System_MT_FE
GITHUB_PROJECT_NUMBER=2
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_PROJECT_DRY_RUN=true
GITHUB_DEFAULT_BRANCH=main
