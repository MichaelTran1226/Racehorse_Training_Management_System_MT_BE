# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL / Supabase / Local PostgreSQL)
# For Supabase:
# DATABASE_URL: Transaction pooler URL (e.g., port 6543)
# DIRECT_URL: Direct session connection URL for Prisma migrations (e.g., port 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/racehorse_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/racehorse_db?schema=public"

# Authentication & JWT Configuration
JWT_SECRET="equiflow-secure-jwt-secret-replace-in-production-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="equiflow-secure-refresh-jwt-secret-replace-in-production-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# Email / Notification Configuration (For Staff Invite & Owner OTP verification)
# Có 3 chế độ: "resend", "smtp", hoặc "mock"
# 1. EMAIL_PROVIDER="resend": Gửi qua Resend API (Khuyên dùng)
#    RESEND_API_KEY="re_xxxxxxxxxxxx"
#    EMAIL_FROM="EquiFlow System <onboarding@resend.dev>" (hoặc email domain đã verify)
# 2. EMAIL_PROVIDER="smtp": Gửi qua SMTP (Gmail App Password hoặc Resend SMTP)
#    SMTP_HOST="smtp.gmail.com" (hoặc "smtp.resend.com")
#    SMTP_PORT=587
#    SMTP_USER="your-email@gmail.com" (hoặc "resend")
#    SMTP_PASS="your-16-char-app-password" (hoặc API key của Resend)
#    EMAIL_FROM="EquiFlow System <your-email@gmail.com>"
# 3. EMAIL_PROVIDER="mock" hoặc để trống key => OTP sẽ in trực tiếp ra server console log
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="EquiFlow System <onboarding@resend.dev>"
# true = mọi mã OTP luôn là 123456 (tiện test). Đặt false khi gửi mail thật.
DEV_FIXED_OTP=true

# GitHub Project Management (Governance)
GITHUB_PROJECT_URL=https://github.com/users/MichaelTran1226/projects/2
GITHUB_OWNER=MichaelTran1226
GITHUB_DEFAULT_REPOSITORY=Racehorse_Training_Management_System_MT_BE
GITHUB_BE_REPOSITORY=Racehorse_Training_Management_System_MT_BE
GITHUB_FE_REPOSITORY=Racehorse_Training_Management_System_MT_FE
GITHUB_PROJECT_NUMBER=2
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_PROJECT_DRY_RUN=true
GITHUB_DEFAULT_BRANCH=main
