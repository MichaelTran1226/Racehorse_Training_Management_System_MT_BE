// EquiFlow - Racehorse Training & Stable Management System
// Prisma Schema Definition for PostgreSQL (Managed via Supabase / Local PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  CLUB_MANAGER
  HEAD_TRAINER
  VETERINARIAN
  GROOM
  HORSE_OWNER
}

// Vòng đời tài khoản (khớp AccountStatus bên FE):
// PENDING_EMAIL (chưa xác minh email) → PENDING_APPROVAL (chờ Club Manager duyệt) → ACTIVE;
// INVITED: nhân viên được mời, chưa đặt mật khẩu; LOCKED / INACTIVE / REJECTED do Club Manager đặt.
enum UserStatus {
  PENDING_EMAIL
  PENDING_APPROVAL
  INVITED
  ACTIVE
  INACTIVE
  REJECTED
  LOCKED
}

enum OtpPurpose {
  SIGNUP
  RESET
  INVITE
}

enum PermissionRequestStatus {
  OPEN
  GRANTED
  DISMISSED
}

enum HorseStatus {
  ACTIVE
  IN_TRAINING
  UNDER_OBSERVATION
  INJURED
  ISOLATED
  RESTING
  RETIRED
}

enum NutritionPlanStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

// Lý do Ngừng quản lý (status = RETIRED). DECEASED không được kích hoạt lại.
enum RetireReason {
  RETIRED
  SOLD
  DECEASED
  TRANSFERRED
}

enum StallStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  INACTIVE // Ngừng dùng (SC-1.07): không hiện trên sơ đồ, không gán được; thay cho xóa ô (Q-1.C)
}

// Loại danh mục của hồ sơ ngựa (SC-1.06)
enum HorseCatalogType {
  BREED
  COLOR
}

enum TrackSurface {
  TURF
  DIRT
  SYNTHETIC
}

// Q14 = A (Flow 2 §4.1): Nháp -> Đang áp dụng -> Hoàn thành / Đã hủy.
enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

// Q14 = A (Flow 2 §4.2). BLOCKED = bị chặn do Khóa y tế (khôi phục được), MISSED = bỏ lỡ.
enum WorkoutStatus {
  SCHEDULED
  COMPLETED
  BLOCKED
  MISSED
  CANCELLED
}

enum BodySide {
  LEFT
  RIGHT
  BILATERAL
}

enum SeverityLevel {
  MILD
  MODERATE
  SEVERE
  CRITICAL
}

enum InjuryStatus {
  ACTIVE
  HEALING
  RESOLVED
}

// Trạng thái vòng đời của hồ sơ bệnh án (DRAFT: Bản nháp, OPEN: Đang điều trị, CLOSED: Đã đóng)
enum MedicalRecordStatus {
  DRAFT
  OPEN
  CLOSED
}

enum PreventiveType {
  VACCINATION
  DEWORMING
  FARRIER_HOOF_CARE
  DENTAL
}

enum PreventiveStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum ShiftType {
  MORNING
  AFTERNOON
  EVENING
}

enum DailyTaskType {
  FEEDING
  CLEANING
  GROOMING
  ICE_BOOT_REST
  WALKING
  MEDICATION
  OTHER
}

enum IncidentStatus {
  REPORTED
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum RestockStatus {
  PENDING
  APPROVED
  DELIVERED
  REJECTED
}

enum TournamentStatus {
  UPCOMING
  OPEN_REGISTRATION
  CLOSED_REGISTRATION
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  SCRATCHED_MEDICAL
  CONFIRMED
  DISQUALIFIED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum InsightType {
  WORKOUT_RECOMMENDATION
  INJURY_RISK_WARNING
  RECOVERY_ADVICE
}

enum InsightStatus {
  GENERATED
  ACKNOWLEDGED
  APPLIED
  DISMISSED
}

enum SupplyCategory {
  FEED_HAY
  FEED_GRAIN
  SUPPLEMENT_VITAMIN
  SUPPLEMENT_MINERAL
  SUPPLEMENT_ELECTROLYTE
  SUPPLEMENT_GENERAL
  MEDICINE
  VACCINE
  DEWORMER
  TOOL_EQUIPMENT
  CLEANING_SUPPLY
}

enum SupplyUnit {
  KG
  G
  LITER
  ML
  PILL
  PACKET
  BOTTLE
  VIAL
  PIECE
  SET
}

enum SimulatorSessionType {
  WORKOUT
  RACE
}

enum SimulatorSessionStatus {
  PENDING
  RUNNING
  COMPLETED
  ABORTED_INJURY
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

model User {
  id                   String     @id @default(uuid())
  email                String     @unique
  passwordHash         String     @default("") // "" = tài khoản INVITED chưa đặt mật khẩu
  passwordChangedAt    DateTime?
  fullName             String
  phoneNumber          String?
  role                 Role
  status               UserStatus @default(PENDING_EMAIL)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  lastActive           DateTime?
  requestedAt          DateTime? // lúc gửi yêu cầu đăng ký (sau khi xác minh email)
  requestCode          String?    @unique // REQ-2609-014
  lockedAt             DateTime?
  invitedBy            String? // tên Club Manager đã mời (tài khoản nhân viên)
  // Lần đổi trạng thái gần nhất do Club Manager làm (duyệt / từ chối / khóa…) kèm lý do nếu có
  statusReason         String?
  statusChangedAt      DateTime?
  statusChangedBy      String?
  // Record<PermissionKey, boolean> / Record<NotifyKey, boolean>; null = mặc định theo vai trò
  // (xem src/users/permissions.ts)
  permissions          Json?
  permissionsChangedAt DateTime?
  permissionsChangedBy String?
  notify               Json?

  horsesOwned           Horse[]                 @relation("OwnerHorses")
  horsesDeleted         Horse[]                 @relation("HorseDeletedBy")
  stallAllocations      StallAllocation[]       @relation("GroomStalls")
  trainingPlansCreated  TrainingPlan[]          @relation("TrainerPlans")
  workoutSessionsStaff  WorkoutSession[]        @relation("StaffWorkouts")
  workoutResultsRecorded WorkoutSession[]       @relation("WorkoutResultRecorder")
  workoutResultsEdited  WorkoutSession[]        @relation("WorkoutResultEditor")
  medicalRecordsExamined MedicalRecord[]        @relation("VetRecords")
  medicalLocksIssued    MedicalLock[]           @relation("VetLocksIssued")
  medicalLocksUnlocked  MedicalLock[]           @relation("VetLocksUnlocked")
  preventiveSchedules   PreventiveSchedule[]    @relation("VetPreventives")
  dailyGroomingLogs     DailyGroomingLog[]      @relation("GroomLogs")
  tournamentRegistrations TournamentRegistration[] @relation("TrainerRegistrations")
  invoicesBilled        FinancialInvoice[]      @relation("OwnerInvoices")
  auditLogs             AuditLog[]              @relation("UserAuditLogs")
  refreshTokens         RefreshToken[]
  permissionRequests    PermissionRequest[]
  notifications         Notification[]
  shiftRosters          ShiftRoster[]           @relation("GroomShiftRosters")
  shiftRostersCreated   ShiftRoster[]           @relation("ShiftRosterCreatedBy")
  nutritionPlansCreated  NutritionPlan[]         @relation("NutritionPlanCreatedBy")
  nutritionPlansApproved NutritionPlan[]         @relation("NutritionPlanApprovedBy")
  dailyTasksCompleted    DailyCareTask[]         @relation("DailyTaskCompletedBy")
  dailyTasksAssigned     DailyCareTask[]         @relation("DailyTaskAssignedGroom")
  incidentsReported      IncidentReport[]        @relation("IncidentReportedBy")
  incidentsReviewed      IncidentReport[]        @relation("IncidentReviewedBy")
  stockBalancesAdjusted  StockBalance[]          @relation("StockBalanceAdjustedBy")
  restockRequestsCreated RestockRequest[]        @relation("RestockRequestedBy")
  restockRequestsReviewed RestockRequest[]       @relation("RestockReviewedBy")
  restockRequestsDelivered RestockRequest[]      @relation("RestockDeliveredBy")

  @@index([email])
  @@index([role])
  @@index([status])
}

// Mã OTP 6 số gửi qua email. Mỗi (email, mục đích) chỉ có 1 mã còn hiệu lực; chỉ lưu bản băm SHA-256.
model OtpCode {
  id        Int        @id @default(autoincrement())
  email     String
  purpose   OtpPurpose
  codeHash  String
  sentAt    DateTime
  expiresAt DateTime
  resendAt  DateTime
  attempts  Int        @default(0)

  @@unique([email, purpose])
}

// Đếm số lần sai mật khẩu theo email (kể cả email không tồn tại).
// Bộ đếm sai mật khẩu. Khóa `email` là "email", "email#<IP>" hoặc "email#*" (đếm trên mọi IP, xem auth.service.ts).
model LoginAttempt {
  email       String    @id
  fails       Int       @default(0)
  lockedUntil DateTime?
  windowStart DateTime? // đầu cửa sổ 1 giờ của dòng "email#*"
}

// Vé đặt mật khẩu, cấp sau khi nhập đúng OTP (quên mật khẩu / nhận lời mời). Chỉ lưu bản băm SHA-256.
model ResetToken {
  tokenHash String   @id
  email     String
  expiresAt DateTime

  @@index([email])
}

// Người dùng bị chặn quyền (403) xin Club Manager mở quyền vào một màn hình.
model PermissionRequest {
  id         Int                     @id @default(autoincrement())
  at         DateTime                @default(now())
  userId     String
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  screen     String
  reference  String
  status     PermissionRequestStatus @default(OPEN)
  resolvedAt DateTime?
  resolvedBy String? // tên Club Manager đã xử lý

  @@index([status])
}

// Bộ đếm cho các mã hiển thị: REQ-YYMM-NNN (requestCode), 403-YYMM-NNNN (mã tham chiếu 403).
enum NotificationCategory {
  ACCOUNT
  HORSE
  TRAINING
  LOCK
  MEDICAL
  NUTRITION
  SYSTEM
}

// Thông báo trong ứng dụng (C-01). Mỗi dòng là 1 thông báo của 1 người nhận.
// FE dịch theo `type` + `params`; `title`/`message` là bản tiếng Anh dự phòng.
model Notification {
  id         String               @id @default(uuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  category   NotificationCategory
  title      String
  message    String
  params     Json?
  link       String?
  senderName String?
  // Chống gửi trùng (VD nhắc lịch định kỳ mỗi ngày chỉ 1 lần): khóa sự kiện + người nhận
  dedupeKey  String?              @unique
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Counter {
  name  String @id
  value Int    @default(0)
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  // Thời điểm token được đổi sang token mới (xoay vòng). NULL = chưa đổi, hoặc bị thu hồi vì
  // đăng xuất / đổi mật khẩu. Dùng để phát hiện token đã đổi mà bị dùng lại (có thể bị đánh cắp).
  rotatedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Horse {
  id              String      @id @default(uuid())
  horseCode       String?     @unique
  name            String
  microchip       String?     @unique
  rfid            String?     @unique
  microchipRfid   String      @unique
  breed           String
  dob             DateTime
  gender          String
  color           String
  avatarUrl       String?
  status          HorseStatus @default(RESTING)
  isMedicalLocked Boolean     @default(false)
  ownerId         String?
  owner           User?       @relation("OwnerHorses", fields: [ownerId], references: [id], onDelete: SetNull)
  retireReason    RetireReason?
  deletedAt       DateTime?
  deletedById     String?
  deletedBy       User?       @relation("HorseDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteReason    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  stallAllocations        StallAllocation[]
  trainingPlans           TrainingPlan[]
  workoutSessions         WorkoutSession[]
  medicalRecords          MedicalRecord[]
  injuryLogs              InjuryLog[]
  medicalLocks            MedicalLock[]
  preventiveSchedules     PreventiveSchedule[]
  nutritionPlans          NutritionPlan[]
  dailyGroomingLogs       DailyGroomingLog[]
  dailyCareTasks          DailyCareTask[]         @relation("HorseDailyCareTasks")
  incidents               IncidentReport[]        @relation("HorseIncidents")
  tournamentRegistrations TournamentRegistration[]
  financialInvoices       FinancialInvoice[]
  aiInsights              AIInsight[]

  @@index([horseCode])
  @@index([microchip])
  @@index([rfid])
  @@index([microchipRfid])
  @@index([ownerId])
  @@index([status])
  @@index([isMedicalLocked])
  @@index([deletedAt])
}

// Khu chuồng (SC-1.07): kích thước lưới sơ đồ = rows × cols.
model StallZone {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String   @unique
  rows        Int      @default(1)
  cols        Int      @default(1)
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stalls         Stall[]
  shiftRosters   ShiftRoster[]
  dailyCareTasks DailyCareTask[]  @relation("ZoneDailyCareTasks")
  incidents      IncidentReport[] @relation("ZoneIncidents")
  stockBalances   StockBalance[]
  restockRequests RestockRequest[]
}

model Stall {
  id             String          @id @default(uuid())
  code           String          @unique
  zone           String          // Tên khu (giữ cho dữ liệu cũ và bộ lọc; đồng bộ với StallZone.name)
  zoneId         String?
  zoneRef        StallZone?      @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  row            Int?
  col            Int?
  status         StallStatus     @default(AVAILABLE)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  allocations    StallAllocation[]
  dailyCareTasks DailyCareTask[]  @relation("StallDailyCareTasks")

  @@unique([zoneId, row, col])
  @@index([zone])
  @@index([code])
}

// Danh mục Giống & Màu lông (SC-1.06). Horse.breed / Horse.color lưu Tên của mục.
model HorseCatalogItem {
  id          String           @id @default(uuid())
  type        HorseCatalogType
  code        String
  name        String
  description String?
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([type, code])
  @@unique([type, name])
  @@index([type, isActive])
}

model StallAllocation {
  id                 String    @id @default(uuid())
  stallId            String
  stall              Stall     @relation(fields: [stallId], references: [id], onDelete: Restrict)
  horseId            String
  horse              Horse     @relation(fields: [horseId], references: [id], onDelete: Restrict)
  assignedGroomUserId String?
  assignedGroom      User?     @relation("GroomStalls", fields: [assignedGroomUserId], references: [id], onDelete: SetNull)
  startDate          DateTime  @default(now())
  endDate            DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([stallId, isActive])
  @@index([horseId, isActive])
}

model TrainingPlan {
  id            String       @id @default(uuid())
  horseId       String
  horse         Horse        @relation(fields: [horseId], references: [id], onDelete: Restrict)
  trainerUserId String
  trainer       User         @relation("TrainerPlans", fields: [trainerUserId], references: [id], onDelete: Restrict)
  // Mã hiển thị GA-000001, sinh bằng bộ đếm Counter("training_plan")
  planCode      String?      @unique
  phaseName     String
  objective     String?
  notes         String?
  phases        Json?
  targetSpeed   Float?
  targetDistance Int?
  trackSurface  TrackSurface @default(TURF)
  startDate     DateTime
  endDate       DateTime
  status        PlanStatus   @default(DRAFT)
  cancelReason      String?
  completionSummary String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  workoutSessions WorkoutSession[]

  @@index([horseId])
  @@index([trainerUserId])
}

model WorkoutSession {
  id                   String        @id @default(uuid())
  trainingPlanId       String
  trainingPlan         TrainingPlan  @relation(fields: [trainingPlanId], references: [id], onDelete: Restrict)
  horseId              String
  horse                Horse         @relation(fields: [horseId], references: [id], onDelete: Restrict)
  assignedStaffUserId  String?
  assignedStaff        User?         @relation("StaffWorkouts", fields: [assignedStaffUserId], references: [id], onDelete: SetNull)
  scheduledDate        DateTime
  // id của giai đoạn trong TrainingPlan.phases (JSON)
  phaseId              String?
  distanceMeters       Int
  // Số hiệp (DL-2.01: 1-10) và tốc độ mục tiêu (km/h)
  repetitions          Int           @default(1)
  targetSpeedKmh       Float?
  targetDurationSeconds Int?
  actualTimeSeconds    Float?
  heartRatePeak        Int?
  heartRateRecovery    Int?
  performanceScore     Float?
  trainerNotes         String?
  status               WorkoutStatus @default(SCHEDULED)
  workoutType          String?       @default("REGULAR")
  intensity            String?       @default("MODERATE")
  trackSurface         String?       @default("TURF")
  jockeyName           String?
  gateNumber           Int?
  averageSpeedKmh      Float?
  topSpeedKmh          Float?
  recoveryTimeMinutes  Float?
  staminaScore         Float?
  injuryRiskLevel      String?       @default("LOW")
  // Lý do bị chặn (BLOCKED) hoặc bị hủy (CANCELLED)
  statusReason         String?
  // HT xác nhận đã trao đổi với VET khi xếp bài nặng lúc ngựa ở trạng thái y tế (DL-2.06)
  medicalOverride      Boolean       @default(false)
  resultRecordedAt     DateTime?
  resultRecordedById   String?
  resultRecordedBy     User?         @relation("WorkoutResultRecorder", fields: [resultRecordedById], references: [id], onDelete: SetNull)
  resultUpdatedAt      DateTime?
  resultUpdatedById    String?
  resultUpdatedBy      User?         @relation("WorkoutResultEditor", fields: [resultUpdatedById], references: [id], onDelete: SetNull)
  // Kết quả thực tế (SC-2.06)
  actualDistanceMeters Int?
  actualSurface        String?
  trackCondition       String?
  completionLevel      String?
  // Nhận xét chuyên môn sau buổi tập (khác trainerNotes = ghi chú chỉ dẫn trước buổi tập)
  resultNotes          String?
  abnormalSignTypes    String[]      @default([])
  // Dấu hiệu bất thường sau buổi tập -> cảnh báo VET (FR-2.14)
  abnormalSigns        Boolean       @default(false)
  abnormalNotes        String?
  vetAcknowledgedAt    DateTime?
  vetNotes             String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  simulatorSession     SimulatorSession?

  @@index([trainingPlanId])
  @@index([horseId])
  @@index([scheduledDate])
}

model MedicalRecord {
  id                  String              @id @default(uuid())
  // Mã hồ sơ bệnh án định danh duy nhất theo định dạng BA-YYMM-NNN
  recordNumber        String?
  horseId             String
  horse               Horse               @relation(fields: [horseId], references: [id], onDelete: Restrict)
  veterinarianUserId  String
  veterinarian        User                @relation("VetRecords", fields: [veterinarianUserId], references: [id], onDelete: Restrict)
  // Trạng thái bệnh án: DRAFT, OPEN, CLOSED
  status              MedicalRecordStatus @default(OPEN)
  examinationDate     DateTime            @default(now())
  // Loại khám lâm sàng (Định kỳ, cấp cứu, theo dõi...)
  examinationType     String?             @default("Routine Clinical")
  // Nguồn phát hiện tình trạng bệnh (Groom báo cáo, Vet phát hiện...)
  discoverySource     String?
  // Mức độ nghiêm trọng của bệnh
  severity            SeverityLevel?      @default(MODERATE)
  // Chỉ số sinh tồn (Vitals) khi thăm khám
  temperature         Float?
  restingHeartRate    Int?
  respiratoryRate     Int?
  weightKg            Float?
  clinicalExamination String?
  symptoms            String
  clinicalDiagnosis   String
  treatmentProtocol   String
  prescriptionDetails String?
  // Thông tin kết thúc và mở lại bệnh án điều trị
  conclusion          String?
  treatmentResult     String?
  closedAt            DateTime?
  reopenedAt          DateTime?
  reopenReason        String?
  // Dữ liệu JSON có cấu trúc cho phác đồ điều trị, đơn thuốc, lịch tái khám và chỉ định xét nghiệm
  treatmentPhases     String?
  prescriptions       String?
  followUps           String?
  labTests            String?
  requiresFollowUp    Boolean             @default(false)
  followUpDate        DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  injuries     InjuryLog[]
  medicalLocks MedicalLock[]

  @@index([horseId])
  @@index([veterinarianUserId])
  @@index([recordNumber])
}

model InjuryLog {
  id              String         @id @default(uuid())
  medicalRecordId String?
  // Thiết lập quan hệ SetNull để bảo toàn dữ liệu điểm chấn thương 2D khi xóa bản nháp bệnh án
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  horseId         String
  horse           Horse          @relation(fields: [horseId], references: [id], onDelete: Restrict)
  coordinateX     Float          // Normalized 0.0 - 1.0 (Lateral Skeleton Map)
  coordinateY     Float          // Normalized 0.0 - 1.0 (Lateral Skeleton Map)
  viewSide        String         @default("LEFT") // LEFT | RIGHT
  layer           String         @default("MUSCLE") // MUSCLE | BONE
  anatomicalZone  String
  bodySide        BodySide       @default(LEFT)
  injuryType      String
  severity        SeverityLevel  @default(MODERATE)
  stage           String         @default("ACUTE") // ACUTE | SUBACUTE | RECOVERING | HEALED
  status          InjuryStatus   @default(ACTIVE)
  description     String?
  discoveryDate   DateTime       @default(now())
  recoveryHistory Json?          // Array of { id, stage, evaluationDate, severity, notes, updatedByUserId, updatedByName, createdAt }
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([horseId])
  @@index([medicalRecordId])
}

model MedicalLock {
  id                   String         @id @default(uuid())
  lockCode             String?        @unique // e.g. KH-000001
  horseId              String
  horse                Horse          @relation(fields: [horseId], references: [id], onDelete: Restrict)
  medicalRecordId      String?
  medicalRecord        MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  veterinarianUserId   String
  veterinarian         User           @relation("VetLocksIssued", fields: [veterinarianUserId], references: [id], onDelete: Restrict)
  lockedAt             DateTime       @default(now())
  expectedRestDays     Int            @default(7)
  recheckDate          DateTime?      // Ngày xem xét lại (DL-3.01)
  appliedMedicalStatus HorseStatus    @default(INJURED)
  lockReason           String
  unlockConditions     String?
  isLocked             Boolean        @default(true)
  unlockedAt           DateTime?
  unlockVetUserId      String?
  unlockVet            User?          @relation("VetLocksUnlocked", fields: [unlockVetUserId], references: [id], onDelete: SetNull)
  unlockReason         String?
  recheckNotes         String?
  extensionHistory     Json?          // Array of { oldRecheckDate, newRecheckDate, reason, updatedByUserId, updatedByName, createdAt }
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([horseId, isLocked])
  @@index([medicalRecordId])
}

model PreventiveTypeCatalog {
  id                String             @id @default(uuid())
  code              String             @unique // e.g. VAC_RABIES
  name              String             @unique // e.g. Tiêm phòng bệnh dại
  category          PreventiveType     @default(VACCINATION)
  intervalDays      Int                // Chu kỳ (ngày)
  advanceNoticeDays Int                @default(7) // Nhắc trước (ngày)
  applyToNewHorses  Boolean            @default(true)
  description       String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  schedules PreventiveSchedule[]

  @@index([category])
  @@index([isActive])
}

model PreventiveSchedule {
  id                  String                 @id @default(uuid())
  horseId             String
  horse               Horse                  @relation(fields: [horseId], references: [id], onDelete: Restrict)
  typeCatalogId       String?
  typeCatalog         PreventiveTypeCatalog? @relation(fields: [typeCatalogId], references: [id], onDelete: SetNull)
  veterinarianUserId  String?
  veterinarian        User?                  @relation("VetPreventives", fields: [veterinarianUserId], references: [id], onDelete: SetNull)
  scheduleType        PreventiveType         @default(VACCINATION)
  dueDate             DateTime
  lastCompletedDate   DateTime?
  completedDate       DateTime?
  productAdministered String?
  batchNumber         String?
  performedByMode     String                 @default("SELF") // SELF | EXTERNAL
  performedByName     String?
  notes               String?
  status              PreventiveStatus       @default(PENDING)
  historyLogs         Json?                  // Timeline array of completion logs
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([horseId])
  @@index([typeCatalogId])
  @@index([dueDate, status])
}

model NutritionPlan {
  id                   String              @id @default(uuid())
  planCode             String?             @unique
  horseId              String
  horse                Horse               @relation(fields: [horseId], references: [id], onDelete: Restrict)
  status               NutritionPlanStatus @default(DRAFT)

  // Tổng định mức thức ăn/ngày và tỷ lệ % so với trọng lượng ngựa
  dailyFeedWeightKg    Float               @default(0)
  targetWeightRatioPct Float               @default(0)
  horseWeightSnapshot  Float?

  // Dữ liệu chi tiết các bữa: Sáng, Trưa, Tối (JSON)
  mealsJson            Json?

  // Trường legacy fallback
  hayFeedKg            Float               @default(0)
  grainFeedKg          Float               @default(0)
  supplementsJson      String?

  specialInstructions  String?

  // Người lập (Head Trainer / Club Manager)
  createdById          String?
  createdBy            User?               @relation("NutritionPlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Người thẩm định / phê duyệt (Veterinarian / Club Manager)
  approvedById         String?
  approvedBy           User?               @relation("NutritionPlanApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?

  // Đánh giá y khoa & lý do từ chối
  rejectionReason      String?
  vetNotes             String?

  validFrom            DateTime            @default(now())
  validTo              DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([horseId])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
}

model DailyGroomingLog {
  id                 String    @id @default(uuid())
  horseId            String
  horse              Horse     @relation(fields: [horseId], references: [id], onDelete: Restrict)
  groomUserId        String
  groom              User      @relation("GroomLogs", fields: [groomUserId], references: [id], onDelete: Restrict)
  shiftDate          DateTime  @default(now())
  shiftType          ShiftType @default(MORNING)
  feedCompleted      Boolean   @default(false)
  cleaningCompleted  Boolean   @default(false)
  groomingCompleted  Boolean   @default(false)
  iceBootCompleted   Boolean   @default(false)
  healthObservations String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([horseId])
  @@index([groomUserId])
  @@index([shiftDate])
}

model Tournament {
  id                   String           @id @default(uuid())
  name                 String
  raceDate             DateTime
  location             String
  distanceMeters       Int
  trackType            TrackSurface     @default(TURF)
  prizePool            Decimal          @default(0) @db.Decimal(12, 2)
  registrationDeadline DateTime
  status               TournamentStatus @default(UPCOMING)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  registrations TournamentRegistration[]

  @@index([raceDate])
  @@index([status])
}

model TournamentRegistration {
  id                    String             @id @default(uuid())
  tournamentId          String
  tournament            Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  horseId               String
  horse                 Horse              @relation(fields: [horseId], references: [id], onDelete: Restrict)
  registeredByTrainerId String
  registeredByTrainer   User               @relation("TrainerRegistrations", fields: [registeredByTrainerId], references: [id], onDelete: Restrict)
  status                RegistrationStatus @default(REGISTERED)
  registrationDate      DateTime           @default(now())
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  result TournamentResult?

  @@unique([tournamentId, horseId])
  @@index([tournamentId])
  @@index([horseId])
}

model TournamentResult {
  id                 String                 @id @default(uuid())
  registrationId     String                 @unique
  registration       TournamentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  finalRank          Int
  finishTimeSeconds  Float
  avgSpeedKmh        Float
  prizeMoneyWon      Decimal                @default(0) @db.Decimal(12, 2)
  officialNotes      String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model FinancialInvoice {
  id            String        @id @default(uuid())
  horseId       String
  horse         Horse         @relation(fields: [horseId], references: [id], onDelete: Restrict)
  ownerId       String
  owner         User          @relation("OwnerInvoices", fields: [ownerId], references: [id], onDelete: Restrict)
  billingPeriod String        // e.g. "2026-09"
  boardingFee   Decimal       @default(0) @db.Decimal(10, 2)
  medicalFee    Decimal       @default(0) @db.Decimal(10, 2)
  trainingFee   Decimal       @default(0) @db.Decimal(10, 2)
  prizeCredit   Decimal       @default(0) @db.Decimal(10, 2)
  netAmount     Decimal       @default(0) @db.Decimal(10, 2)
  status        InvoiceStatus @default(DRAFT)
  invoiceUrl    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([horseId])
  @@index([ownerId])
  @@index([billingPeriod])
}

model AIInsight {
  id                 String        @id @default(uuid())
  horseId            String
  horse              Horse         @relation(fields: [horseId], references: [id], onDelete: Restrict)
  insightType        InsightType
  trainingLoadIndex  Float
  riskScore          Float
  recommendationsJson String       // JSON string of AI suggestions
  status             InsightStatus @default(GENERATED)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([horseId])
  @@index([insightType])
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  action        String
  entityName    String
  entityId      String?
  oldValuesJson String?  // JSON string snapshot before change
  newValuesJson String?  // JSON string snapshot after change
  ipAddress     String?
  userAgent     String?
  timestamp     DateTime @default(now())

  @@index([userId])
  @@index([entityName, entityId])
  @@index([timestamp])
}

// -------------------------------------------------------------
// FLOW 4 - PHASE 1: SUPPLIES, SHIFTS & ROSTERS
// -------------------------------------------------------------

model SupplyCatalog {
  id             String         @id @default(uuid())
  code           String         @unique
  name           String         @unique
  category       SupplyCategory
  unit           SupplyUnit
  unitPrice      Decimal        @default(0) @db.Decimal(12, 2)
  withdrawalDays Int?
  description    String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  stockBalances   StockBalance[]
  restockRequests RestockRequest[]

  @@index([category])
  @@index([isActive])
}

model ShiftCatalog {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String        @unique
  startTime   String        // e.g. "05:00"
  endTime     String        // e.g. "13:00"
  isOvernight Boolean       @default(false)
  sortOrder   Int           @default(0)
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  shiftRosters   ShiftRoster[]
  dailyCareTasks DailyCareTask[]

  @@index([isActive])
  @@index([sortOrder])
}

model ShiftRoster {
  id          String       @id @default(uuid())
  date        DateTime     @db.Date
  shiftId     String
  shift       ShiftCatalog @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  zoneId      String
  zone        StallZone    @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  groomUserId String
  groom       User         @relation("GroomShiftRosters", fields: [groomUserId], references: [id], onDelete: Restrict)
  notes       String?
  createdById String?
  createdBy   User?        @relation("ShiftRosterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([date, shiftId, zoneId, groomUserId])
  @@index([date, zoneId])
  @@index([groomUserId, date])
}

// -------------------------------------------------------------
// FLOW 4 - PHASE 3: DAILY CARE CHECKLIST & INCIDENTS
// -------------------------------------------------------------

model DailyCareTask {
  id                  String        @id @default(uuid())
  taskCode            String?       @unique // e.g. "TASK-20261018-001"
  date                DateTime      @db.Date
  horseId             String
  horse               Horse         @relation("HorseDailyCareTasks", fields: [horseId], references: [id], onDelete: Restrict)
  stallZoneId         String?
  stallZone           StallZone?    @relation("ZoneDailyCareTasks", fields: [stallZoneId], references: [id], onDelete: SetNull)
  stallId             String?
  stall               Stall?        @relation("StallDailyCareTasks", fields: [stallId], references: [id], onDelete: SetNull)
  taskType            DailyTaskType @default(FEEDING)
  title               String
  description         String?
  mealType            String?       // MORNING, NOON, EVENING, or null
  scheduledTime       String?       // e.g. "06:00", "08:30", "11:30", "14:00", "17:00"
  shiftId             String?
  shift               ShiftCatalog? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  // Liên kết dinh dưỡng & y tế
  nutritionPlanId     String?
  isMedicalLocked     Boolean       @default(false)
  medicalLockNotes    String?
  itemsSnapshotJson   Json?         // Snapshot các món ăn (nếu là FEEDING) hoặc hướng dẫn

  // Trạng thái hoàn thành & hoàn tác
  isCompleted         Boolean       @default(false)
  completedAt         DateTime?
  completedById       String?
  completedBy         User?         @relation("DailyTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  assignedGroomUserId String?
  assignedGroom       User?         @relation("DailyTaskAssignedGroom", fields: [assignedGroomUserId], references: [id], onDelete: SetNull)
  undoUntil           DateTime?     // Cửa sổ 15 phút cho phép hoàn tác

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([date, horseId, taskType, mealType, scheduledTime])
  @@index([date, stallZoneId])
  @@index([assignedGroomUserId, date])
  @@index([horseId, date])
  @@index([isCompleted])
}

model IncidentReport {
  id               String         @id @default(uuid())
  sourceEventId    String?        @unique
  incidentNumber   String?        @unique // e.g. "INC-20261018-0001"
  horseId          String
  horse            Horse          @relation("HorseIncidents", fields: [horseId], references: [id], onDelete: Restrict)
  stallZoneId      String?
  stallZone        StallZone?     @relation("ZoneIncidents", fields: [stallZoneId], references: [id], onDelete: SetNull)
  reportedById     String
  reportedBy       User           @relation("IncidentReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)
  severity         SeverityLevel  @default(MILD) // MILD, MODERATE, CRITICAL
  symptomsJson     Json           // Array of symptom keys/strings
  description      String         // Bắt buộc nhập quan sát hiện trường
  status           IncidentStatus @default(REPORTED)
  vetNotes         String?
  reviewedById     String?
  reviewedBy       User?          @relation("IncidentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  medicalRecordId  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([horseId])
  @@index([reportedById])
  @@index([severity, status])
  @@index([createdAt])
}

// -------------------------------------------------------------
// FLOW 4 - PHASE 4: INVENTORY & SUPPLY RESTOCK
// -------------------------------------------------------------

model StockBalance {
  id                String        @id @default(uuid())
  zoneId            String
  zone              StallZone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  supplyId          String
  supply            SupplyCatalog @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  quantity          Decimal       @default(0) @db.Decimal(12, 2)
  minThreshold      Decimal       @default(10) @db.Decimal(12, 2)
  lastInventoryDate DateTime?
  lastAdjustedById  String?
  lastAdjustedBy    User?         @relation("StockBalanceAdjustedBy", fields: [lastAdjustedById], references: [id], onDelete: SetNull)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([zoneId, supplyId])
  @@index([zoneId])
  @@index([supplyId])
}

model RestockRequest {
  id                String        @id @default(uuid())
  requestNumber     String?       @unique // e.g. "REQ-20261018-0001"
  zoneId            String
  zone              StallZone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  supplyId          String
  supply            SupplyCatalog @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  requestedQuantity Decimal       @db.Decimal(12, 2)
  approvedQuantity  Decimal?      @db.Decimal(12, 2)
  status            RestockStatus @default(PENDING)
  urgencyReason     String?
  rejectionReason   String?
  requestedById     String
  requestedBy       User          @relation("RestockRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById      String?
  reviewedBy        User?         @relation("RestockReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  deliveredAt       DateTime?
  deliveredById     String?
  deliveredBy       User?         @relation("RestockDeliveredBy", fields: [deliveredById], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([zoneId])
  @@index([supplyId])
  @@index([status])
  @@index([requestedById])
}

// -------------------------------------------------------------
// SIMULATOR REALTIME & SESSION PERSISTENCE
// -------------------------------------------------------------

model SimulatorSession {
  id            String                 @id
  type          SimulatorSessionType
  status        SimulatorSessionStatus @default(RUNNING)
  horseIds      String[]
  lastSnapshot  Json?
  result        Json?
  actorUserId   String
  workoutSessionId String?                @unique
  workoutSession   WorkoutSession?        @relation(fields: [workoutSessionId], references: [id], onDelete: SetNull)
  startedAt     DateTime               @default(now())
  finishedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, updatedAt])
}

